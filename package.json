{
  "name": "cinefila",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Catálogo de filmes em Ionic com Angular standalone",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "configurar": "node scripts/configurar.mjs",
    "prestart": "npm run configurar",
    "start": "ng serve --host 0.0.0.0 --port 8100",
    "prebuild": "npm run configurar",
    "build": "ng build --configuration production",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --import tsx --test tests/unit.spec.ts",
    "test:e2e": "playwright test",
    "verificar:mapa": "node scripts/verificar-mapa.mjs",
    "zip": "node scripts/gerar-zip.mjs"
  },
  "dependencies": {
    "@angular/common": "20.3.35",
    "@angular/compiler": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/forms": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "@angular/router": "20.3.35",
    "@ionic/angular": "8.8.19",
    "ionicons": "8.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.42",
    "@angular/cli": "20.3.42",
    "@angular/compiler-cli": "20.3.35",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.1",
    "happy-dom": "20.8.4",
    "jszip": "3.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
